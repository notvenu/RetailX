# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local env
.env*.local

_state.json
_shots.mjs
.impeccable/

.playwright-mcp/
__pycache__/

# per-instance data store (users, businesses, records)
/.data/

# old ML pipeline leftovers (local downloads and trained models, never committed)
ml/

# e2e output
/test-results/
/playwright-report/
!.env.example
