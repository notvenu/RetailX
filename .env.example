# Copy to .env.local and fill in what you use. Everything except AUTH_SECRET is optional:
# the app works without each service and says so where it matters.

# Sessions. Generate one with: npx auth secret
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Public URL for emailed reset / verification links. Required in production (never taken from request headers);
# in development the request host is used.
APP_URL=

# Database. Unset = local SQLite file at .data/retailx.db. For hosting, a free Turso database:
#   turso db create retailx && turso db show retailx --url && turso db tokens create retailx
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# RETAILX_DB=/path/to/file.db   # override the local file location

# AI roles. Unset = rule-based briefings from your KPIs.
# Claude (paid API; a Claude Pro chat subscription does not include API access):
ANTHROPIC_API_KEY=
# Or free: a Gemini key from https://aistudio.google.com/apikey (no card). Any OpenAI-compatible API works:
#   Groq: AI_BASE_URL=https://api.groq.com/openai/v1  AI_MODEL=openai/gpt-oss-120b
#   Ollama (offline): AI_BASE_URL=http://localhost:11434/v1  AI_MODEL=qwen2.5:7b  AI_API_KEY=ollama
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Email (Resend, free tier). Unset = emails go to the outbox and the server log.
RESEND_API_KEY=
EMAIL_FROM=RetailX <onboarding@resend.dev>

# WhatsApp Cloud API (Meta). Unset = one-tap wa.me links a person sends.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Scheduler: /api/cron runs automations, morning briefings and clean-up when called with
# "Authorization: Bearer $CRON_SECRET" (Vercel Cron sends it automatically; or use cron-job.org).
CRON_SECRET=

# Browser push. Unset = keys are generated on first use and stored in the database.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
